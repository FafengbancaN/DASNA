# Python and build products
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local interpreters and editors
.venv/
venv/
.conda/
.idea/
.vscode/
/.local/
.DS_Store
Thumbs.db

# Machine-specific credentials and configuration
.env
.env.*
!.env.example
*.pem
*.key

# Research datasets and derived caches stay local
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/generated/*
!/data/generated/.gitkeep

# Training outputs
/artifacts/
/runs/
/logs/
/wandb/
*.pt
*.pth
*.ckpt
*.log

# Temporary files
/tmp/
*.tmp
~$*
